<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to local.build.props (ignored by git). Keep public and beta installs separate. -->
<Project>
  <PropertyGroup>
    <PublicIl2CppGamePath>D:/Games/Schedule I_public</PublicIl2CppGamePath>
    <BetaIl2CppGamePath>D:/Games/Schedule I_beta</BetaIl2CppGamePath>
    <!-- Mono requires alternate / alternate-beta game installations. -->
    <PublicMonoGamePath>D:/Games/Schedule I_alternate</PublicMonoGamePath>
    <BetaMonoGamePath>D:/Games/Schedule I_alternate-beta</BetaMonoGamePath>

    <!-- Legacy MonoGamePath/Il2CppGamePath still select Public only. -->
    <!-- Assembly-only inputs can be used instead of full game roots:
    <BetaIl2CppAssembliesPath>D:/Refs/beta/MelonLoader/Il2CppAssemblies</BetaIl2CppAssembliesPath>
    <BetaIl2CppMelonLoaderPath>D:/Refs/beta/MelonLoader/net6</BetaIl2CppMelonLoaderPath>
    <BetaMonoAssembliesPath>D:/Refs/alternate-beta/Managed</BetaMonoAssembliesPath>
    <BetaMonoMelonLoaderPath>D:/Refs/alternate-beta/MelonLoader</BetaMonoMelonLoaderPath>
    Public equivalents use the Public prefix.
    -->

    <!-- Builds produce artifacts only by default. Enable deliberate local deployment:
    <AutomateLocalDeployment>true</AutomateLocalDeployment>
    <BetaClientDeploymentPath>D:/Games/Schedule I_beta/Mods</BetaClientDeploymentPath>
    <BetaServerDeploymentPath>D:/Servers/Schedule I_beta/Mods</BetaServerDeploymentPath>
    Existing runtime-specific Public deployment overrides remain supported.
    -->
  </PropertyGroup>
</Project>
